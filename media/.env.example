# Copy to .env locally; never commit the local .env.
PUID=1000
PGID=1000
TZ=Etc/UTC
MEDIA_ROOT=/srv/media
DOWNLOAD_ROOT=/srv/media/Downloads
# Safe default: only this host. Set to a specific LAN address deliberately.
LISTEN_ADDRESS=127.0.0.1
# Does not establish VPN routing or provide a torrent kill switch.
TORRENT_BIND_ADDRESS=127.0.0.1
