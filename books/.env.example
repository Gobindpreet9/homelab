# Copy ONLY into the private deployment at /srv/homelab/books/.env.
# Keep the real file root-owned, mode 0600; never commit or print it.
# Blank API values deliberately prevent normal Compose rendering/startup.
SHELFMARK_API_KEY=
PROWLARR_API_KEY=
QBITTORRENT_API_KEY=
# Explicitly select authorized ebook-capable indexers; do not select all implicitly.
PROWLARR_INDEXERS=REPLACE_WITH_AUTHORIZED_INDEXER_IDS
